# Data files - New organization schema
# Ignore all content inside data_landing_zone, but track the directory structure via .gitkeep files
/data_landing_zone/*
!/data_landing_zone/.gitkeep
!/data_landing_zone/raw/
/data_landing_zone/raw/*
!/data_landing_zone/raw/.gitkeep
!/data_landing_zone/intermediate/
/data_landing_zone/intermediate/*
!/data_landing_zone/intermediate/.gitkeep
!/data_landing_zone/warehouses/
/data_landing_zone/warehouses/*
!/data_landing_zone/warehouses/.gitkeep

# Raw data (Module input)
/data_landing_zone/raw/uploads/
/data_landing_zone/raw/database_exports/
/data_landing_zone/raw/file_imports/
/data_landing_zone/raw/staging/

# Intermediate data (Module processing)
/data_landing_zone/intermediate/*/validated/
/data_landing_zone/intermediate/*/cleaned/
/data_landing_zone/intermediate/*/aggregated/
/data_landing_zone/intermediate/*/optimized/

# Warehouse data (Module 4 output)
/data_landing_zone/warehouses/*/postgresql/
/data_landing_zone/warehouses/*/clickhouse/
/data_landing_zone/warehouses/*/hdfs/
/data_landing_zone/warehouses/*/exports/

