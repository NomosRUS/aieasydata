{
    "scenario_id": "S026",
    "name": "DAG Monitoring and Status Check",
    "description": "Мониторинг статуса DAG'ов в Airflow",
    "category": "airflow_integration",
    "priority": "medium",
    "expected_duration": 30,
    "steps": [
        {
            "step": 1,
            "description": "Получение списка всех DAG'ов",
            "action": "external_api_call",
            "endpoint": "http://localhost:8080/api/v1/dags",
            "method": "GET",
            "timeout": 15,
            "save_to": "all_dags",
            "expected_status": [200, 401, 404]
        },
        {
            "step": 2,
            "description": "Проверка статуса конкретного DAG'а",
            "action": "external_api_call",
            "endpoint": "http://localhost:8080/api/v1/dags/example_dag",
            "method": "GET",
            "timeout": 10,
            "save_to": "dag_details",
            "expected_status": [200, 404]
        },
        {
            "step": 3,
            "description": "Получение последних запусков DAG'ов",
            "action": "external_api_call",
            "endpoint": "http://localhost:8080/api/v1/dags/~/dagRuns",
            "method": "GET",
            "timeout": 15,
            "parameters": {
                "limit": 10,
                "order_by": "-execution_date"
            },
            "save_to": "recent_runs",
            "expected_status": [200, 404]
        },
        {
            "step": 4,
            "description": "Проверка здоровья Airflow",
            "action": "external_api_call",
            "endpoint": "http://localhost:8080/health",
            "method": "GET",
            "timeout": 10,
            "save_to": "airflow_health",
            "expected_status": [200, 404]
        }
    ],
    "success_criteria": [
        "Получена информация о DAG'ах или Airflow недоступен",
        "Статус системы определен"
    ],
    "cleanup": [],
    "tags": ["airflow", "monitoring", "dag_status", "health_check"]
}
