{
    "scenario_id": "S003",
    "name": "Filesystem to HDFS",
    "description": "Загрузка данных из файловой системы в HDFS через все модули",
    "category": "end_to_end_flows",
    "prerequisites": {
        "filesystem_source": "data_landing_zone/syn_csv",
        "target_db": "hdfs_test"
    },
    "steps": [
        {
            "step": 1,
            "description": "Health-check Модуля 1",
            "action": "module_api_call",
            "module": 1,
            "endpoint": "health-check",
            "method": "GET",
            "save_to": "step_1_output"
        },
        {
            "step": 2,
            "description": "Автоопределение типа данных из файловой системы (Модуль 5)",
            "action": "module_api_call",
            "module": 5,
            "endpoint": "auto-detect",
            "method": "GET",
            "params": {
                "source": "/data/syn_csv"
            },
            "save_to": "step_2_output"
        },
        {
            "step": 3,
            "description": "Валидация данных из файловой системы (Модуль 1)",
            "action": "module_api_call",
            "module": 1,
            "endpoint": "validate-file",
            "method": "POST",
            "params": {
                "file_path": "/data/syn_csv",
                "validation_options": {
                    "check_duplicates": true,
                    "assess_quality": true
                }
            },
            "save_to": "step_3_output"
        },
        {
            "step": 4,
            "description": "Создание сценария агрегации (Модуль 2)",
            "action": "module_api_call",
            "module": 2,
            "endpoint": "create-scenario",
            "method": "POST",
            "payload": {
                "name": "filesystem_aggregation_test_{{timestamp}}",
                "description": "Test aggregation scenario for filesystem data",
                "sources": [
                    {
                        "source_id": "csv_files",
                        "source_type": "file",
                        "path": "/data/syn_csv",
                        "selected_columns": [
                            "category",
                            "region",
                            "amount",
                            "quantity"
                        ]
                    }
                ],
                "aggregations": [
                    {
                        "type": "group_by",
                        "parameters": {
                            "columns": [
                                "category",
                                "region"
                            ],
                            "aggregates": {
                                "total_amount": "sum(amount)",
                                "transaction_count": "count(quantity)"
                            }
                        }
                    }
                ],
                "target_requirements": {
                    "expected_volume": "<5GB",
                    "refresh_interval": "daily"
                }
            },
            "save_to": "step_4_output"
        },
        {
            "step": 5,
            "description": "Анализ производительности (Модуль 3)",
            "action": "module_api_call",
            "module": 3,
            "endpoint": "analyze",
            "method": "POST",
            "payload": {
                "source": "/data/syn_csv"
            },
            "save_to": "step_5_output"
        },
        {
            "step": 6,
            "description": "Поиск существующего профиля данных",
            "action": "module_api_call",
            "module": 0,
            "endpoint": "/api/data-inventory",
            "method": "GET",
            "save_to": "step_6_output"
        },
        {
            "step": 7,
            "description": "Создание профиля, если не найден",
            "action": "module_api_call",
            "module": 0,
            "endpoint": "/api/v1/data-profiles",
            "method": "POST",
            "payload": {
                "source_path": "/data/syn_csv"
            },
            "save_to": "step_7_output",
            "condition": "not any(p['source_path'] == '/data/syn_csv' for p in step_6_output.data)"
        },
        {
            "step": 8,
            "description": "Извлечение ID существующего профиля",
            "action": "json_path_extract",
            "source": "{{step_6_output.data}}",
            "expression": "$[?(@.source_path=='/data/syn_csv')].id | [0]",
            "save_to": "existing_profile_id",
            "condition": "not step_7_output"
        },
        {
            "step": 9,
            "description": "Выбор корректного profile_id",
            "action": "set_variable",
            "name": "source_profile_id",
            "value": "{{ step_7_output.id if step_7_output else existing_profile_id }}",
            "save_to": "step_9_output"
        },
        {
            "step": 10,
            "description": "Проектирование HDFS хранилища (Модуль 4)",
            "action": "module_api_call",
            "module": 4,
            "endpoint": "design",
            "method": "POST",
            "payload": {
                "source_profile_id": "{{step_9_output.source_profile_id}}",
                "business_requirements": "Big Data analytics for transaction data",
                "analytics_requirements": {},
                "constraints": {}
            },
            "save_to": "step_10_output"
        },
        {
            "step": 11,
            "description": "Подтверждение дизайна хранилища для HDFS (Модуль 4)",
            "action": "module_api_call",
            "module": 4,
            "endpoint": "/design/{{step_10_output.design_id}}/confirm",
            "method": "POST",
            "payload": {
                "chosen_db": "hdfs"
            },
            "save_to": "step_11_output"
        }
    ],
    "validation": {
        "final_checks": [
            {
                "type": "hdfs_directory_exists",
                "path": "/warehouse/transaction_analytics"
            },
            {
                "type": "data_count_match",
                "source": "filesystem",
                "target": "hdfs_directory"
            },
            {
                "type": "data_quality_preserved",
                "threshold": 0.95
            }
        ]
    },
    "ai_training": {
        "goal": "Load filesystem data into HDFS with full pipeline",
        "success_pattern": "health_check -> auto_detect -> validate -> aggregate -> analyze -> profile -> design -> confirm",
        "key_decisions": [
            "target_db_selection",
            "partitioning_strategy",
            "compression_settings"
        ]
    }
}