{
    "scenario_id": "S001",
    "name": "External API to PostgreSQL Full Cycle",
    "description": "Загрузка данных из внешнего API через все модули в PostgreSQL",
    "category": "end_to_end_flows",
    "prerequisites": {
        "external_api": "test_sales_api",
        "target_db": "postgresql_test"
    },
    "steps": [
        {
            "step": 1,
            "description": "Health-check Модуля 1",
            "action": "module_api_call",
            "module": 1,
            "endpoint": "health-check",
            "method": "GET",
            "save_to": "step_1_output"
        },
        {
            "step": 2,
            "description": "Автоопределение типа данных (Модуль 5)",
            "action": "module_api_call",
            "module": 5,
            "endpoint": "auto-detect",
            "method": "GET",
            "params": {
                "source": "/data/raw/sales.csv"
            },
            "save_to": "step_2_output"
        },
        {
            "step": 3,
            "description": "Валидация файла (Модуль 1)",
            "action": "module_api_call",
            "module": 1,
            "endpoint": "validate-file",
            "method": "POST",
            "params": {
                "file_path": "/data/raw/sales.csv"
            },
            "save_to": "step_3_output"
        },
        {
            "step": 4,
            "description": "Создание сценария агрегации (Модуль 2)",
            "action": "module_api_call",
            "module": 2,
            "endpoint": "create-scenario",
            "method": "POST",
            "payload": {
                "name": "sales_aggregation_test_{{timestamp}}",
                "description": "Test aggregation scenario",
                "sources": [
                    {
                        "source_id": "sales_csv",
                        "source_type": "file",
                        "path": "/data/raw/sales.csv",
                        "selected_columns": [
                            "category",
                            "region",
                            "amount",
                            "quantity"
                        ]
                    }
                ],
                "aggregations": [
                    {
                        "type": "group_by",
                        "parameters": {
                            "columns": [
                                "category",
                                "region"
                            ],
                            "aggregates": {
                                "total_amount": "sum(amount)",
                                "transaction_count": "count(quantity)"
                            }
                        }
                    }
                ],
                "target_requirements": {
                    "expected_volume": "<1GB",
                    "refresh_interval": "daily"
                }
            },
            "save_to": "step_4_output"
        },
        {
            "step": 5,
            "description": "Анализ производительности (Модуль 3)",
            "action": "module_api_call",
            "module": 3,
            "endpoint": "analyze",
            "method": "POST",
            "payload": {
                "source": "/data/raw/sales.csv"
            },
            "save_to": "step_5_output"
        },
        {
            "step": 6,
            "description": "Поиск существующего профиля данных",
            "action": "module_api_call",
            "module": 0,
            "endpoint": "/api/data-inventory",
            "method": "GET",
            "save_to": "step_6_output"
        },
        {
            "step": 7,
            "description": "Создание профиля, если не найден",
            "action": "module_api_call",
            "module": 0,
            "endpoint": "data-profiles",
            "method": "POST",
            "payload": {
                "source_path": "/data/raw/sales.csv"
            },
            "save_to": "step_7_output",
            "condition": "not any(p['source_path'] == '/data/raw/sales.csv' for p in step_6_output['data'])"
        },
        {
            "step": 8,
            "description": "Проектирование хранилища (Модуль 4)",
            "action": "module_api_call",
            "module": 4,
            "endpoint": "design",
            "method": "POST",
            "payload": {
                "source_profile_id": "1",
                "business_requirements": "OLAP cube for sales analysis",
                "analytics_requirements": {},
                "constraints": {}
            },
            "save_to": "step_8_output"
        },
        {
            "step": 9,
            "description": "Подтверждение дизайна хранилища (Модуль 4)",
            "action": "module_api_call",
            "module": 4,
            "endpoint": "/design/{{step_8_output.design_id}}/confirm",
            "method": "POST",
            "payload": {
                "chosen_db": "clickhouse"
            },
            "save_to": "step_9_output"
        }
    ],
    "validation": {
        "final_checks": []
    },
    "ai_training": {
        "goal": "Full E2E test from file to ClickHouse warehouse",
        "success_pattern": "health_check -> auto_detect -> validate -> aggregate -> analyze -> profile -> design -> confirm",
        "key_decisions": []
    }
}