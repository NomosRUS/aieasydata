# ============================================
# ЛОКАЛЬНАЯ LLM (Ollama)
# ============================================
# Переключение: true = локальная LLM, false = OpenAI API
#
# Доступные модели (проверьте наличие через ollama list):
# - aboba/saiga_mistral_13b - русская модель на базе Mistral (7.9GB)
# - openchat:7b - базовая английская модель (4.1GB)
# - mistral:7b-instruct - улучшенная поддержка инструкций (4.1GB)
# - llama3:8b - сбалансированная модель (4.7GB)
# - gemma:2b - легковесная модель от Google (1.4GB)
#
# Для смены модели:
# 1. Установите: ollama pull <имя_модели>
# 2. Обновите LOCAL_LLM_MODEL ниже
# 3. Перезапустите приложение

LOCAL_LLM_ENABLED=true

# URL Ollama сервера
LOCAL_LLM_BASE_URL=http://localhost:11434

# Модель (рекомендуется aboba/saiga_mistral_13b - отличная русская модель на базе Mistral)
LOCAL_LLM_MODEL=aboba/saiga_mistral_13b

# Фолбек на OpenAI при ошибках локальной LLM
LOCAL_LLM_FALLBACK=true

# Таймаут для локальной LLM (секунды)
LOCAL_LLM_TIMEOUT=120

# Параметры генерации
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_MAX_TOKENS=2048